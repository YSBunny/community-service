MYSQL_IMAGE=mysql:8.4

MYSQL_DATABASE=nyareureuk
MYSQL_USER=example_user
MYSQL_PASSWORD=example_password
MYSQL_ROOT_PASSWORD=example_root_password

SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/nyareureuk?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8

JWT_SECRET=example-jwt-secret-for-compose-validation-only

MYSQL_VOLUME_NAME=nyareureuk-mysql-data
UPLOAD_VOLUME_NAME=nyareureuk-upload-data