# =========================
# Frontend: client
# =========================
client/node_modules/
client/dist/
client/build/
client/coverage/
client/*.local

# Frontend environment variables
client/.env
client/.env.*
!client/.env.example
!client/.env.production

# =========================
# Backend: server
# =========================
server/.gradle/
server/build/
server/out/
server/bin/
server/*.class
!server/gradle/wrapper/gradle-wrapper.jar

# Backend environment variables and local configuration
server/.env
server/.env.*
!server/.env.example
server/src/main/resources/application-secret.yml
server/src/main/resources/application-secret.yaml
server/src/main/resources/application-secret.properties

# Backend runtime data
server/data/
server/uploads/
server/logs/
server/*.pid
server/*.db
server/*.sqlite
server/*.sqlite3
server/*.mv.db
server/*.trace.db

# =========================
# Shared
# =========================
.env
.idea/
**/.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
**/*.iml
**/*.iws
**/*.ipr

logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

.DS_Store
